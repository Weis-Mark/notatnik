#!/bin/bash
# Pobiera najnowsze wersje aplikacji z GitHuba (uruchamiane co 30 minut).
export LC_ALL=C
W=/var/www/aplikacje
get(){ # aplikacja plik...
  local app=$1; shift; mkdir -p "${W:?}/${app:?}"
  for f in "$@"; do
    if curl -fsSL --max-time 60 "https://raw.githubusercontent.com/Weis-Mark/$app/main/$f" -o "${W:?}/${app:?}/.${f:?}.tmp"; then
      mv -f "${W:?}/${app:?}/.${f:?}.tmp" "${W:?}/${app:?}/${f:?}"
    fi
  done
}
get notatnik index.html sw.js manifest.webmanifest icon-192.png icon-512.png icon-maskable-512.png apple-touch-icon.png
chmod -R a+rX "${W:?}"
X
chmod 755 /usr/local/sbin/aplikacje-aktualizuj
/usr/local/sbin/aplikacje-aktualizuj
echo "*/30 * * * * root /usr/local/sbin/aplikacje-aktualizuj" > /etc/cron.d/aplikacje-aktualizuj
[ -s /var/www/aplikacje/notatnik/index.html ] && echo OK || { echo "BLAD: nie udalo sie pobrac notatnika"; exit 1; }

